# Doc Assistant on your own server: copy to deploy/server/.env and fill in (docs/DEPLOY.md).
# This one file holds the server settings and the app settings. Never commit the real .env.

# With n8n (escalation e-mails, the weekly gap report): automation. Empty: the app only.
COMPOSE_PROFILES=automation

# --- address and HTTPS ---------------------------------------------------------------------
# The domain that points to the server (an A record in the DNS), e.g. asistent.firma.rs
DOMAIN=asistent.example.com
# n8n's own address (only with COMPOSE_PROFILES=automation), e.g. n8n.firma.rs
N8N_DOMAIN=n8n.example.com
# Let's Encrypt sends certificate notices here
ACME_EMAIL=it@example.com

# --- the password before the app ------------------------------------------------------------
AUTH_USER=firma
# A hash of the password, never the password itself. Make it on the server with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'lozinka'
# and keep the single quotes: the hash contains "$", which would be read as a variable.
AUTH_PASSWORD_HASH='$2a$14$replace.this.with.the.output.of.caddy.hash-password'

# --- the app (the same settings as the main .env.example) -----------------------------------
# Paid tier: free tiers may use the documents; Groq gpt-oss-120b ~0.50 $ per 1,000 questions.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Or Claude (LLM_PROVIDER=claude): Haiku 5.5 ~0.35 $, Sonnet 5.5 ~7 $ per 1,000 questions.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# A long random string: integrations (n8n) send it as X-API-Key. Make one with:
#   openssl rand -hex 32
API_TOKEN=

ALLOW_UPLOADS=true
MAX_QUESTIONS_PER_SESSION=300
MAX_QUESTIONS_PER_IP_HOUR=600
ESCALATION_TEAMS=hr:HR:hr@firma.rs,maintenance:Održavanje:odrzavanje@firma.rs,quality:Kontrola kvaliteta:kvalitet@firma.rs
INBOX_POLL_S=10

# --- backups ----------------------------------------------------------------------------------
# Every night (cron syntax), kept this many days, in deploy/server/backups/
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
