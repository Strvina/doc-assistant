{
  "name": "Doc Assistant - weekly report of documentation gaps",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "00000000-0000-0000-0000-000000000101",
      "name": "Every Monday at 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "id": "00000000-0000-0000-0000-000000000105",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "url": "={{ ($env.DOC_ASSISTANT_URL || 'http://host.docker.internal:8000') + '/reports/gaps' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "days", "value": "7" },
            { "name": "classify", "value": "true" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.DOC_ASSISTANT_API_KEY || '' }}" }
          ]
        },
        "options": {}
      },
      "id": "00000000-0000-0000-0000-000000000102",
      "name": "Fetch the gap report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "teams",
        "options": {}
      },
      "id": "00000000-0000-0000-0000-000000000103",
      "name": "One item per team",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [520, 0]
    },
    {
      "parameters": {
        "fromEmail": "doc-assistant@example.com",
        "toEmail": "={{ $json.email || 'hr@example.com' }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "00000000-0000-0000-0000-000000000104",
      "name": "E-mail the team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [780, 0],
      "credentials": {
        "smtp": {
          "id": "DocAssistMailpit",
          "name": "Mailpit (local test inbox)"
        }
      }
    }
  ],
  "connections": {
    "Every Monday at 8:00": {
      "main": [[{ "node": "Fetch the gap report", "type": "main", "index": 0 }]]
    },
    "Run now": {
      "main": [[{ "node": "Fetch the gap report", "type": "main", "index": 0 }]]
    },
    "Fetch the gap report": {
      "main": [[{ "node": "One item per team", "type": "main", "index": 0 }]]
    },
    "One item per team": {
      "main": [[{ "node": "E-mail the team", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "id": "DocAssistGapRepo"
}
