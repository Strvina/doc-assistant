# Kopiraj u .env i popuni. .env se NIKAD ne commituje.

# Koji LLM odgovara: claude | openai
LLM_PROVIDER=claude

# Anthropic (Claude) — ključ sa console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI — potreban i za embeddings kad je LLM Claude
OPENAI_API_KEY=
# Upiši aktuelni chat model iz OpenAI dokumentacije
OPENAI_MODEL=
# Proveri u OpenAI dokumentaciji da je model i dalje aktuelan
EMBEDDING_MODEL=text-embedding-3-small

# Pretraga
INDEX_DIR=data/index
TOP_K=5
