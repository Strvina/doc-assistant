# Kopiraj u .env i popuni. .env se NIKAD ne commituje.

# Ko daje odgovore: claude | groq | gemini | openai | fake (fake = bez ključa, samo za probu UI-ja)
# groq / gemini = besplatni nivoi (ADR-021, ADR-022) — za demo bez plaćenih kredita;
# ako su oba ključa postavljena, drugi služi kao rezerva kad prvi potroši limit
LLM_PROVIDER=claude

# Anthropic (Claude) — ključ sa console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opciono: low | medium | high | xhigh | max (prazno = podrazumevano za model). Niže = jeftinije/brže.
ANTHROPIC_EFFORT=

# Google Gemini — besplatan ključ na https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Prazno = gemini-3.5-flash; rezervni model kad je glavni preopterećen (prazno = gemini-flash-lite-latest)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Groq — besplatan ključ na https://console.groq.com (API Keys)
GROQ_API_KEY=
# Prazno = openai/gpt-oss-120b; rezervni (prazno = openai/gpt-oss-20b)
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# Pretraga (embeddings): local | openai | fake
# local = besplatan višejezični model na ovom računaru (~220 MB, preuzme se jednom u EMBEDDING_CACHE_DIR)
EMBEDDING_PROVIDER=local
# Prazno = podrazumevani model za izabrani provajder
EMBEDDING_MODEL=
EMBEDDING_CACHE_DIR=data/models

INDEX_DIR=data/index
# Kopije originalnih dokumenata (za pregled sa označenim citatom i preuzimanje)
DOCUMENTS_DIR=data/documents
# Fajlovi ubačeni u ovaj folder se sami dodaju u biblioteku (skener, n8n…; ADR-036/037).
# Podrazumevani folder; korisnik bira drugi u aplikaciji ("Automatski uvoz iz foldera").
# Proverava se na INBOX_POLL_S sekundi; 0 = isključeno.
INBOX_DIR=data/inbox
INBOX_POLL_S=10
TOP_K=5
# Pretraga: true = značenje (embeddings) + ključne reči (BM25), false = samo embeddings (ADR-023)
HYBRID_SEARCH=true
# OCR za skenove i tekst na slikama (Tesseract, lokalno; ADR-024). false = isključeno
OCR=true
# Jezici (Tesseract kodovi): srpski latinica + ćirilica, nemački, engleski
OCR_LANGUAGES=srp_latn+srp+deu+eng

# --- Opciono: ChatGPT (OpenAI) kao drugi model; bez ključa se ne prikazuje u UI-ju ---
OPENAI_API_KEY=
OPENAI_MODEL=

# Web aplikacija — za javni demo: ALLOW_UPLOADS=false i niski limiti (troškovi API-ja)
ALLOW_UPLOADS=true
MAX_UPLOAD_MB=20
MAX_QUESTIONS_PER_SESSION=30
MAX_QUESTIONS_PER_IP_HOUR=120

# Agent: kuda ide eskalacija pitanja čoveku. Prazno = upis u data/outbox/escalations.jsonl
# Za n8n: URL Webhook čvora iz automations/escalation_workflow.json
ESCALATION_WEBHOOK_URL=
OUTBOX_DIR=data/outbox
# Timovi kojima se prosleđuje pitanje bez odgovora (dugmad u UI-ju, izbor za agenta):
# id:Naziv:e-mail, odvojeno zarezom. Prazno = HR, Održavanje, Kontrola kvaliteta (demo adrese)
ESCALATION_TEAMS=

# Ako je postavljen: integracije šalju header  X-API-Key: <token>, a browser dobija sesiju
# kad otvori web UI. Prazno = otvoreno (interna mreža).
API_TOKEN=

# Nalozi i uloge (ADR-048): true = svako se prijavljuje svojim nalogom (zaposleni / urednik /
# administrator). Prvog administratora napravi pre uključivanja:
#   uv run python -m docassist.cli users add <ime> --role admin
LOGIN_REQUIRED=false

# Sajtovi koji smeju da prikažu aplikaciju u iframe-u (Hugging Face Space: https://huggingface.co)
EMBED_ORIGINS=

# Log pitanja/odgovora/ocena — SQLite fajl, nije u gitu
LOG_DB=data/logs.sqlite
