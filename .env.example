# Kopiraj u .env i popuni. .env se NIKAD ne commituje.

# Odgovore daje Claude (ADR-018): claude | fake (fake = bez ključa, samo za probu UI-ja)
LLM_PROVIDER=claude

# Anthropic (Claude) — ključ sa console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opciono: low | medium | high | xhigh | max (prazno = podrazumevano za model). Niže = jeftinije/brže.
ANTHROPIC_EFFORT=

# Pretraga (embeddings): local | openai | fake
# local = besplatan višejezični model na ovom računaru (~220 MB, preuzme se jednom u EMBEDDING_CACHE_DIR)
EMBEDDING_PROVIDER=local
# Prazno = podrazumevani model za izabrani provajder
EMBEDDING_MODEL=
EMBEDDING_CACHE_DIR=data/models

INDEX_DIR=data/index
# Kopije originalnih dokumenata (za pregled sa označenim citatom i preuzimanje)
DOCUMENTS_DIR=data/documents
TOP_K=5

# --- Opciono: ChatGPT (OpenAI) kao drugi model; bez ključa se ne prikazuje u UI-ju ---
OPENAI_API_KEY=
OPENAI_MODEL=

# Web aplikacija — za javni demo: ALLOW_UPLOADS=false i niski limiti (troškovi API-ja)
ALLOW_UPLOADS=true
MAX_UPLOAD_MB=20
MAX_QUESTIONS_PER_SESSION=30
MAX_QUESTIONS_PER_IP_HOUR=120

# Agent: kuda ide eskalacija pitanja čoveku. Prazno = upis u data/outbox/escalations.jsonl
# Za n8n: URL Webhook čvora iz automations/escalation_workflow.json
ESCALATION_WEBHOOK_URL=
OUTBOX_DIR=data/outbox

# Ako je postavljen: integracije šalju header  X-API-Key: <token>, a browser dobija sesiju
# kad otvori web UI. Prazno = otvoreno (interna mreža).
API_TOKEN=

# Log pitanja/odgovora/ocena — SQLite fajl, nije u gitu
LOG_DB=data/logs.sqlite
