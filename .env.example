# Kopiraj u .env i popuni. .env se NIKAD ne commituje.

# Koji LLM odgovara: claude | openai | fake (fake = bez ključa, vraća prvu rečenicu najboljeg chunk-a)
LLM_PROVIDER=claude

# Anthropic (Claude) — ključ sa console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opciono: low | medium | high | xhigh | max (prazno = podrazumevano za model). Niže = jeftinije/brže.
ANTHROPIC_EFFORT=

# OpenAI — potreban i za embeddings kad je LLM Claude
OPENAI_API_KEY=
# Upiši aktuelni chat model iz OpenAI dokumentacije
OPENAI_MODEL=
# Embeddings: openai | fake (fake = bez ključa, samo za lokalno probanje; kvalitet slab)
EMBEDDING_PROVIDER=openai
# Proveri u OpenAI dokumentaciji da je model i dalje aktuelan
EMBEDDING_MODEL=text-embedding-3-small

# Pretraga
INDEX_DIR=data/index
TOP_K=5

# Web UI (Streamlit) — za javni demo: ALLOW_UPLOADS=false i nizak limit pitanja (troškovi API-ja)
ALLOW_UPLOADS=true
MAX_QUESTIONS_PER_SESSION=30

# Agent (faza 5): kuda ide eskalacija pitanja čoveku. Prazno = upis u data/outbox/escalations.jsonl
# Za n8n: URL Webhook čvora iz automations/escalation_workflow.json
ESCALATION_WEBHOOK_URL=
OUTBOX_DIR=data/outbox

# REST API (faza 5): ako je postavljen, svaki zahtev mora imati header  X-API-Key: <token>
API_TOKEN=
